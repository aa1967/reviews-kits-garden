{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL", "POSTGRES_USER", "POSTGRES_PASSWORD", "POSTGRES_DB",
        "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "BASE_URL", "NODE_ENV", "PORT",
        "SMTP_HOST", "SMTP_PORT", "SMTP_FROM", "SMTP_USER", "SMTP_PASS",
        "CORS_ALLOWED_ORIGINS", "AUTH_TRUSTED_ORIGINS", "DNS_OVER_HTTPS_URL",
        "TRUSTED_PROXY_IPS", "MAX_ACTIVE_MONITORS"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL", "TEST_DATABASE_URL", "POSTGRES_USER", "POSTGRES_PASSWORD",
        "POSTGRES_DB", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "BASE_URL", "NODE_ENV"
      ],
      "cache": false
    }
  }
}
