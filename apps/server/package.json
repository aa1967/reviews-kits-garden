{
  "name": "@reviewskits/server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "drizzle-kit": "^0.31.9",
    "postgres": "^3.4.8"
  },
  "scripts": {
    "dev": "bun run --parallel dev:api worker",
    "dev:api": "bun --env-file=../../.env run --hot src/index.ts",
    "build": "bun build src/index.ts src/worker.ts --outdir dist --target bun",
    "worker": "bun --env-file=../../.env src/worker.ts",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:seed:admin": "bun --env-file=../../.env scripts/seed-admin.ts",
    "test:e2e:prepare": "bun --env-file=../../.env scripts/prepare-e2e-db.ts",
    "lint": "tsc --noEmit",
    "test": "bun --env-file=../../.env scripts/test.ts",
    "test:unit": "bun scripts/test.ts --unit"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.2.2",
    "@noble/hashes": "2.4.0",
    "@react-email/components": "^1.0.11",
    "@react-email/render": "^2.0.5",
    "@reviewskits/types": "workspace:*",
    "@scure/base": "2.4.0",
    "better-auth": "^1.5.5",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "ipaddr.js": "2.2.0",
    "nodemailer": "^8.0.4",
    "react": "^19.2.4",
    "tldts": "7.0.28",
    "zod": "^4.3.6"
  }
}
