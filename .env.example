# Local development. bun run dev creates .env automatically when it is missing,
# replacing the password and auth-secret placeholders with random credentials.
# Production configuration: docs/deployment.md

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=reviewskits
DATABASE_URL=postgresql://postgres:your_secure_password@127.0.0.1:5433/reviewskits
BETTER_AUTH_SECRET=your_super_secret_auth_key_min_32_chars

BASE_URL=http://localhost:5180
BETTER_AUTH_URL=http://localhost:3000/api/auth

# Mailpit captures local verification and notification emails.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@reviewskits.local
SMTP_USER=
SMTP_PASS=

# The first signup on a fresh database becomes administrator.
SEED_ADMIN_ON_START=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAX_ACTIVE_MONITORS=100
# Optional trusted DNS-over-HTTPS JSON resolver:
# DNS_OVER_HTTPS_URL=https://cloudflare-dns.com/dns-query
# Reverse proxy IPs allowed to supply forwarded client addresses:
# TRUSTED_PROXY_IPS=
# Optional separate test database for PostgreSQL roles without CREATE DATABASE:
# TEST_DATABASE_URL=postgresql://postgres:your_secure_password@127.0.0.1:5433/reviewskits_test
