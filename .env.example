# ─── Domaine ──────────────────────────────────────────────────
DOMAIN=mondomaine.com
ACME_EMAIL=admin@mondomaine.com

# ─── Base de données (PostgreSQL) ─────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=reviewskits

# Local dev URL — bun dev runs on the host, use localhost with the mapped port
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5433/reviewskits
# Tests create and remove a separate database. For restricted PostgreSQL roles,
# explicitly configure a different database whose name includes "_test":
# TEST_DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5433/reviewskits_test

# Production / Docker-internal URL (only use this inside the Docker network)
# DATABASE_URL=postgresql://postgres:your_secure_password@db:5432/reviewskits

# ─── Auth ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your_super_secret_auth_key_min_32_chars

# ─── Compte admin initial ─────────────────────────────────────
ADMIN_EMAIL=admin@mondomaine.com
ADMIN_PASSWORD=admin_secure_password
# Optional explicit provisioning instead of first-signup bootstrap.
# SEED_ADMIN_ON_START=false
# CORS Allowed Origins (Comma separated URLs)
# CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5180,http://localhost:3000,http://localhost:4000

# ─── Email (SMTP) ─────────────────────────────────────────────
# Laisser SMTP_HOST vide pour désactiver les notifications email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-password

# URL de base de l'application (obligatoire si SMTP_HOST est défini)
# BASE_URL=https://your-domain.com

# ─── Public review directory ───────────────────────────────────
# Required in production for verification callbacks, invitations and widget links.
# BASE_URL=https://reviews.your-domain.com
# SMTP_FROM=no-reply@your-domain.com
# For local email testing: SMTP_HOST=localhost, SMTP_PORT=1025,
# SMTP_FROM=no-reply@reviewskits.local (Mailpit; no SMTP credentials required).
# The directory worker starts with bun run dev; in production use the
# infra/docker-compose.directory.yml overlay or bun run worker from apps/server.
MAX_ACTIVE_MONITORS=100
# Optional trusted DNS-over-HTTPS JSON resolver if ordinary DNS is unavailable:
# DNS_OVER_HTTPS_URL=https://cloudflare-dns.com/dns-query
# Explicit comma-separated reverse proxy IPs allowed to supply x-forwarded-for.
# Leave empty unless the proxy removes untrusted forwarded headers.
# TRUSTED_PROXY_IPS=
